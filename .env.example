# App
APP_NAME=radius-server
APP_ENV=production
APP_PORT=8080
APP_DEBUG=false
APP_URL=https://yourdomain.com
CWMP_PORT=7547

# Database
DB_HOST=localhost
DB_PORT=5432
DB_NAME=backend_radius
DB_USER=backend_radius
DB_PASSWORD=
DB_SSL_MODE=disable

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# JWT
JWT_PRIVATE_KEY_PATH=./keys/private.pem
JWT_PUBLIC_KEY_PATH=./keys/public.pem
JWT_ACCESS_EXPIRY=15m
JWT_REFRESH_EXPIRY=168h

# RADIUS
RADIUS_LISTEN_AUTH=:1812
RADIUS_LISTEN_ACCT=:1813
RADIUS_SECRET=

# VPN (WireGuard)
VPN_INTERFACE=wg0
VPN_SUBNET=10.10.0.0/24
VPN_SERVER_IP=10.10.0.1
VPN_LISTEN_PORT=51820

# CORS
CORS_ALLOWED_ORIGINS=https://yourdomain.com,http://localhost:3000

# Log
LOG_LEVEL=info
LOG_FORMAT=console

# Storage
STORAGE_DRIVER=local
STORAGE_PATH=./storage

# GenieACS
GENIEACS_URL=http://localhost:7557
GENIEACS_USERNAME=
GENIEACS_PASSWORD=

# WhatsApp
WA_SERVICE_URL=https://wa.yourdomain.com
WA_API_SECRET=

# Firebase Cloud Messaging
FCM_SERVER_KEY=
FCM_ENABLED=false

# Payment Gateway — subscribe tenant ke platform (bukan billing pelanggan ISP)
# PG_PROVIDER: bank_transfer (manual, default) | midtrans | xendit | tripay
PG_PROVIDER=bank_transfer
PG_API_KEY=
PG_SECRET_KEY=
PG_MERCHANT_ID=
PG_SANDBOX=true

# Rekening tujuan untuk PG_PROVIDER=bank_transfer
BANK_TRANSFER_BANK_NAME=BCA
BANK_TRANSFER_ACCOUNT_NUMBER=1750566584
BANK_TRANSFER_ACCOUNT_HOLDER=Candra Syahputra
